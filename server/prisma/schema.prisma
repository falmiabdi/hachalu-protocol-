generator client {
  provider = "prisma-client-js"
  // NOTE (Hachalu dev): binaryTargets limited to "native" locally because the
  // engine CDN download of the linux targets stalls on this dev machine.
  // Restore to ["native","rhel-openssl-3.0.x","rhel-openssl-1.1.x","debian-openssl-3.0.x"]
  // before deploying to Render/cPanel (postinstall regenerates engines there).
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  agent
  owner
  user
  worker
}

enum UserStatus {
  Pending
  Approved
  Rejected
  Suspended
}

enum ProductStatus {
  Draft
  Pending
  Approved
  Rejected
  OutOfStock
  Archived
}

enum ProductGender {
  Male
  Female
  Child
  Unisex
}

enum OrderStatus {
  PendingPayment
  Paid
  MeasurementPending
  MeasurementConfirmed
  Assigned
  InProduction
  Packed
  Delivered
  Completed
  Cancelled
  Refunded
}

enum OrderType {
  ready_made
  custom
}

enum PaymentStatus {
  Pending
  Completed
  Failed
  Refunded
  Expired
}

enum PaymentMethod {
  chapa
  telebirr
}

enum SavedItemType {
  product
}

enum JobStatus {
  Assigned
  Started
  InProgress25
  InProgress50
  InProgress75
  Ready
  QualityCheck
  Completed
}

enum WorkerStatus {
  Available
  Busy
  OnLeave
  Inactive
}

enum MachineStatus {
  Available
  InUse
  Maintenance
  Disabled
}

enum MaterialCategory {
  Fabric
  Thread
  Buttons
  Zippers
  Lining
  Other
}

enum MovementType {
  In
  Out
}

enum Unit {
  meter
  piece
  roll
  kg
  pack
  other
}

enum MeasurementUnit {
  cm
  inch
  meter
}

enum CommissionStatus {
  Pending
  Paid
  Void
}

enum CommissionScope {
  Order
  Product
}

enum PermissionType {
  EDIT
  DELETE
}

enum PermissionStatus {
  Pending
  Approved
  Rejected
}

enum PermissionEntityType {
  PRODUCT
  ORDER
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @db.VarChar(50)
  email              String     @unique
  password           String?
  role               UserRole   @default(user)
  roles              Json       @default("[]")
  status             UserStatus @default(Pending)
  rejectionReason    String?
  isRootAdmin        Boolean    @default(false)
  profilePhoto       String?
  phone              String?
  documents          Json       @default("[]")
  education          Json       @default("[]")
  professionalInfo   Json?
  profile            Json       @default("{}")
  firebaseUid        String?    @unique
  authProvider       String?    @default("email")
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  emailVerified      Boolean    @default(false)
  emailVerifiedAt    DateTime?  @db.Timestamptz(3)
  verificationToken  String?
  otp                String?    @db.VarChar(6)
  otpExpiresAt       DateTime?  @db.Timestamptz(3)
  onboardingComplete Boolean    @default(false)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  savedItems         SavedItem[]
  announcements      Announcement[]
  deviceTokens       DeviceToken[]
  reviewsGiven       Review[]            @relation("reviewerReviews")
  reviewsReceived    Review[]            @relation("agentReviews")
  permissionRequests PermissionRequest[] @relation("permissionRequesters")
  permissionsDecided PermissionRequest[] @relation("permissionDeciders")
  products           Product[]
  customerOrders     Order[]             @relation("orderCustomers")
  sellerOrders       Order[]             @relation("orderSellers")
  measurements       CustomerMeasurement[]
  employeeProfile    Worker?
  productReviews     ProductReview[]
  commissions        Commission[]        @relation("commissionSellers")

  @@index([role, status])
  @@map("users")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(100)
  slug        String         @unique
  gender      ProductGender
  description String?
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  products  Product[]
  templates MeasurementTemplate[]

  @@unique([slug, gender])
  @@map("hachalu_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  origin    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  products Product[]

  @@map("hachalu_brands")
}

model ColorOption {
  id       String   @id @default(uuid()) @db.Uuid
  name     String   @unique @db.VarChar(50)
  hex      String?  @db.VarChar(9)
  active   Boolean  @default(true)

  variants ProductVariant[]

  @@map("hachalu_color_options")
}

model SizeOption {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(30)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  variants ProductVariant[]

  @@map("hachalu_size_options")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(200)
  slug            String        @unique
  description     String?       @db.Text
  categoryId      String        @db.Uuid
  gender          ProductGender
  ageGroup        String?
  brandId         String?       @db.Uuid
  countryOfOrigin String?
  fabric          String?
  isReadyMade     Boolean       @default(true)
  isCustomizable  Boolean       @default(false)
  featured        Boolean       @default(false)
  status          ProductStatus @default(Draft)
  rejectionReason String?
  images          Json          @default("[]")
  videoUrl        String?
  sellerId        String        @db.Uuid
  sellerName      String
  displayPhone    String?
  contactMode     String?       @default("Admin")
  contactUserId   String?       @db.Uuid
  views           Int           @default(0)
  favorites       Int           @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  category  Category        @relation(fields: [categoryId], references: [id])
  brand     Brand?          @relation(fields: [brandId], references: [id])
  seller    User            @relation(fields: [sellerId], references: [id])
  variants  ProductVariant[]
  orderItems OrderItem[]
  reviews   ProductReview[]
  productionJobs ProductionJob[]
  commissions Commission[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("hachalu_products")
}

model ProductVariant {
  id        String    @id @default(uuid()) @db.Uuid
  sku       String    @unique
  productId String    @db.Uuid
  sizeId    String?   @db.Uuid
  colorId   String?   @db.Uuid
  price     Float
  stock     Int       @default(0)
  status    String    @default("active")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       SizeOption?   @relation(fields: [sizeId], references: [id])
  color      ColorOption?  @relation(fields: [colorId], references: [id])
  orderItems OrderItem[]

  @@unique([productId, sizeId, colorId])
  @@index([productId])
  @@map("hachalu_product_variants")
}

model MeasurementTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(100)
  categoryId String?  @db.Uuid
  fields     Json     @default("[]")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  category    Category?           @relation(fields: [categoryId], references: [id])
  measurements CustomerMeasurement[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@map("hachalu_measurement_templates")
}

model CustomerMeasurement {
  id            String           @id @default(uuid()) @db.Uuid
  templateId    String           @db.Uuid
  customerId    String           @db.Uuid
  enteredById   String?          @db.Uuid
  orderId       String?
  values        Json             @default("{}")
  unit          MeasurementUnit  @default(cm)
  notes         String?
  referencePhoto String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  template MeasurementTemplate @relation(fields: [templateId], references: [id])
  customer User                @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([templateId])
  @@index([orderId])
  @@map("hachalu_customer_measurements")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  orderNumber    String      @unique
  type           OrderType
  customerId     String      @db.Uuid
  sellerId       String?     @db.Uuid
  status         OrderStatus @default(PendingPayment)
  totalPrice     Float
  paymentStatus  String?     @default("Pending")
  deliveryInfo   Json?
  notes          String?
  cancelledReason String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  customer User        @relation("orderCustomers", fields: [customerId], references: [id])
  seller   User?       @relation("orderSellers", fields: [sellerId], references: [id])
  items    OrderItem[]
  productionJobs ProductionJob[]
  commissions Commission[]

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("hachalu_orders")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  type          OrderType
  productId     String?  @db.Uuid
  variantId     String?  @db.Uuid
  quantity      Int      @default(1)
  unitPrice     Float
  subtotal      Float
  templateId    String?  @db.Uuid
  measurementId String?
  styleNotes    Json?
  status        String   @default("active")

  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?             @relation(fields: [productId], references: [id])
  variant     ProductVariant?      @relation(fields: [variantId], references: [id])
  template    MeasurementTemplate? @relation(fields: [templateId], references: [id])
  productionJobs ProductionJob[]

  @@index([orderId])
  @@index([productId])
  @@map("hachalu_order_items")
}

model Worker {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @unique @db.Uuid
  specialty String?
  phone     String?
  status    WorkerStatus @default(Available)
  machineId String?      @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  user    User               @relation(fields: [userId], references: [id])
  machine Machine?           @relation(fields: [machineId], references: [id])
  jobs    WorkerAssignment[]

  @@index([status])
  @@map("hachalu_workers")
}

model Machine {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(100)
  type             String?
  code             String?       @unique
  status           MachineStatus @default(Available)
  location         String?
  maintenanceNotes String?
  lastMaintenance  DateTime?     @db.Timestamptz(3)
  nextMaintenance  DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  workers Worker[]

  @@index([status])
  @@map("hachalu_machines")
}

model ProductionJob {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @db.Uuid
  orderItemId String?   @db.Uuid
  productId   String?   @db.Uuid
  status      JobStatus @default(Assigned)
  startTime   DateTime? @db.Timestamptz(3)
  endTime     DateTime? @db.Timestamptz(3)
  notes       String?
  qcStatus    String?   @default("Pending")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  order     Order                 @relation(fields: [orderId], references: [id])
  orderItem OrderItem?            @relation(fields: [orderItemId], references: [id])
  product   Product?              @relation(fields: [productId], references: [id])
  assignees WorkerAssignment[]

  @@index([orderId])
  @@index([status])
  @@map("hachalu_production_jobs")
}

model WorkerAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  jobId         String    @db.Uuid
  workerId      String    @db.Uuid
  role          String?   @default("tailor")
  assignedAt    DateTime  @default(now()) @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)

  job    ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker Worker        @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@index([workerId])
  @@map("hachalu_worker_assignments")
}

model Material {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  category        MaterialCategory
  unit            Unit             @default(meter)
  currentQuantity Float            @default(0)
  minStockLevel   Float            @default(10)
  notes           String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  movements StockMovement[]

  @@index([category])
  @@map("hachalu_materials")
}

model StockMovement {
  id          String       @id @default(uuid()) @db.Uuid
  materialId  String       @db.Uuid
  type        MovementType
  quantity    Float
  note        String?
  orderId     String?
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([createdAt])
  @@map("hachalu_stock_movements")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @unique
  merchOrderId     String
  txRef            String
  status           PaymentStatus @default(Pending)
  amount           Float
  currency         String        @default("ETB")
  method           PaymentMethod
  paymentType      String
  buyerName        String
  buyerEmail       String
  buyerPhone       String
  orderTitle       String?
  notificationData Json?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String
  body      String
  type      String
  read      Boolean   @default(false)
  readAt    DateTime? @db.Timestamptz(3)
  data      Json?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt])
  @@index([readAt])
  @@map("notifications")
}

model Message {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String
  senderId      String   @db.Uuid
  senderName    String
  senderRole    String
  recipientId   String   @db.Uuid
  recipientName String
  content       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([productId])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("messages")
}

model Announcement {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(200)
  content   String   @db.Text
  authorId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([createdAt])
  @@map("announcements")
}

model SavedItem {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  itemType  SavedItemType
  itemId    String        @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, itemType, itemId])
  @@map("saved_items")
}

model Setting {
  id               String   @id @default("default")
  contactPhone1    String?
  contactPhone2    String?
  contactPhone3    String?
  contactEmail     String?
  socialFacebook   String?
  socialTelegram   String?
  socialWhatsapp   String?
  socialTiktok     String?
  socialLinkedin   String?
  socialInstagram  String?
  socialYoutube    String?
  lowStockThreshold Int?    @default(10)
  defaultCommissionRate Float? @default(0.10)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  reviewerId String   @db.Uuid
  agentId    String   @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  reviewer User @relation("reviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  agent    User @relation("agentReviews", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, agentId])
  @@index([agentId])
  @@map("reviews")
}

model ProductReview {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  orderId   String?  @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@map("hachalu_product_reviews")
}

model Commission {
  id         String            @id @default(uuid()) @db.Uuid
  sellerId   String            @db.Uuid
  orderId    String?           @db.Uuid
  productId  String?           @db.Uuid
  scope      CommissionScope   @default(Order)
  rate       Float
  amount     Float
  status     CommissionStatus  @default(Pending)
  paidAt     DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  seller  User     @relation("commissionSellers", fields: [sellerId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([sellerId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("hachalu_commissions")
}

model PermissionRequest {
  id          String               @id @default(uuid()) @db.Uuid
  type        PermissionType
  entityType  PermissionEntityType
  entityId    String               @db.Uuid
  requesterId String               @db.Uuid
  status      PermissionStatus     @default(Pending)
  reason      String?
  used        Boolean              @default(false)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?            @db.Timestamptz(3)
  decidedById String?              @db.Uuid

  requester User  @relation("permissionRequesters", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("permissionDeciders", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([requesterId])
  @@index([status])
  @@map("permission_requests")
}